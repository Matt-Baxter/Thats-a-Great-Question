# Copy this file to .env and put your Anthropic API key after the "=".
# The real value goes in .env locally and in Vercel's environment settings —
# never in this file, and never anywhere in the repository.
#
# The app reads QUESTION_APP_API_KEY and deliberately ignores ANTHROPIC_API_KEY,
# so a key set for some other tool on the same machine is never used
# (research.md R11).
QUESTION_APP_API_KEY=
